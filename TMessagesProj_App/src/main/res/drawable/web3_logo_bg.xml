<?xml version="1.0" encoding="utf-8"?>
<!-- Logo 背景 - 带发光效果 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 背景色 -->
    <solid android:color="#1A1A1C" />

    <!-- 边框 - 荧光绿 -->
    <stroke
        android:width="1dp"
        android:color="#33CFFF55" />

    <!-- 圆角 -->
    <corners android:radius="24dp" />

</shape>
