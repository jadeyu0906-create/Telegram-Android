<?xml version="1.0" encoding="utf-8"?>
<!-- 一键免密接入按钮背景 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 透明背景 -->
    <solid android:color="#00000000" />

    <!-- 边框 -->
    <stroke
        android:width="1dp"
        android:color="#CFFF55" />

    <!-- 圆角 -->
    <corners android:radius="16dp" />

</shape>
