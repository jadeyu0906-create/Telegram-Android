<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0E0E10"
    android:gravity="center"
    android:padding="24dp">

    <!-- 顶部间距 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Logo 区域 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="48dp">

        <!-- Telegram Logo 容器 -->
        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/web3_logo_bg"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_telegram_logo"
                android:contentDescription="Telegram Logo" />
        </FrameLayout>

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Web3 × Telegram"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- 副标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="去中心化 Web3 生态与轻量社交的融合体\n继续使用原有账号、联系人与群组"
            android:textSize="14sp"
            android:textColor="#A0A0A0"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp" />
    </LinearLayout>

    <!-- 底部间距 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Telegram 账号快捷登录按钮 -->
        <Button
            android:id="@+id/btn_telegram_login"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Telegram 账号快捷登录"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:background="@drawable/btn_telegram_login"
            android:drawableLeft="@drawable/ic_telegram_small"
            android:drawablePadding="12dp"
            android:gravity="center"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:layout_marginBottom="12dp"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

        <!-- 一键免密接入按钮 -->
        <Button
            android:id="@+id/btn_quick_access"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="一键免密接入体验"
            android:textSize="16sp"
            android:textColor="#CFFF55"
            android:textStyle="bold"
            android:background="@drawable/btn_quick_access"
            android:gravity="center"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:layout_marginBottom="8dp"
            android:stateListAnimator="@null"
            android:elevation="0dp" />

        <!-- 底部说明文字 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="100% 资金由 u多担保 智能合约与赔付准备金双重托底"
            android:textSize="10sp"
            android:textColor="#666666"
            android:gravity="center"
            android:paddingTop="4dp" />
    </LinearLayout>

</LinearLayout>
