<?xml version="1.0" encoding="utf-8"?>
<!-- 一键免密接入确认弹窗（复刻 HTML modal-one-click） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000">

    <!-- 弹窗卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:background="@drawable/dialog_background"
        android:padding="20dp"
        android:gravity="center">

        <!-- 闪电图标容器 -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/dialog_icon_bg">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bolt" />
        </FrameLayout>

        <!-- 标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/quick_access_dialog_title"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 描述 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/quick_access_dialog_message"
            android:textColor="#A1A1A1"
            android:textSize="12sp"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />

        <!-- 按钮行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- 取消按钮 -->
            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/quick_access_dialog_cancel"
                android:textColor="#A1A1A1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/btn_dialog_cancel"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:layout_marginEnd="4dp" />

            <!-- 立即接入按钮 -->
            <Button
                android:id="@+id/btn_confirm"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/quick_access_dialog_confirm"
                android:textColor="#000000"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/btn_dialog_confirm"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:layout_marginStart="4dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
